# HTTP framing of the control server (fuzz_controlserver); @KEY@ and @PORT@ are replaced by the real values
"@KEY@"
"@PORT@"
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
"POST /api HTTP/1.1"
"GET /api/commands HTTP/1.1"
"GET /api/hello?nonce="
"Host: 127.0.0.1:@PORT@"
"Host: localhost:@PORT@"
"Authorization: Bearer @KEY@"
"Content-Length: "
"Origin: "
"X-PinglyMotion-Client: "
"{\"command\":\"state\"}"
