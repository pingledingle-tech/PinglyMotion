// PinglyMotion, package B: RLV questions for Firestorm (or any RLV viewer).
//
// GENERATED by tools/firestorm/make_rlv_questions.py from reference/rlv/questions.txt. Do not edit the
// list below by hand: change questions.txt and run the generator (tests/test_rlvref.py checks it).
//
// What it does: you touch the object, it asks the viewer a list of RLV questions one by one and says
// the questions and the answers in local chat, in lines that start with "RLVREF|". Copy those chat lines
// and give them to the project: tools/firestorm/chat_to_rlvref.py turns them into a reference file.
//
// Safety, in plain words:
//   - Questions only. It never sends money, teleports, sits, wears or takes off anything, and sends no
//     message to anyone. The only things it ever sets are the three restrictions that hide hover text
//     (@showhovertextworld, @showhovertexthud, @showhovertextall), and it sends @clear after every case,
//     at the start and at the end, and when it is taken off or the script is reset.
//   - If anything looks wrong: take the object off or delete it, or type @clear in the RLV console, or
//     relog. RLV restrictions end when the object that set them is gone.
//   - The answers of @getgroup and @getinv can hold personal names (your active group, inventory folders).
//     chat_to_rlvref.py hides them; look at the chat text before you share it anyway.
//
// How: RLV must be on (Firestorm: Preferences > Firestorm > ... or Advanced > RLVa, then relog). Rez or
// wear this object. Open nearby chat. Touch it and wait about two minutes until it says "RLVREF|# done".
// Not tested in Second Life by the project (it cannot run a viewer); the first run is the test.

list LINES = [
    "case version_text",
    "send @version=2222",
    "send @versionnew=2223",
    "send @versionnum=2224",
    "case status_one",
    "send @showhovertextworld=n",
    "send @getstatus=2222",
    "case status_two_in_order",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @getstatus=2222",
    "case status_filter",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @getstatus:world=2222",
    "case status_separator",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @getstatus:;|=2222",
    "case status_norwegian_separator",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @getstatus:;æøå=2222",
    "case clear_with_filter",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @clear=world",
    "send @getstatus=2222",
    "case notify_add_and_remove",
    "send @notify:2222=add",
    "send @showhovertextworld=n",
    "send @showhovertextworld=y",
    "case notify_with_filter",
    "send @notify:2222;hud=add",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "case sitting_nowhere",
    "send @getsitid=2222",
    "case outfit_worn_shape",
    "send @getoutfit:shape=2222",
    "case outfit_all_layers_are_digits",
    "send @getoutfit=2222",
    "case attach_all_points_are_digits",
    "send @getattach=2222",
    "case status_long_norwegian_under_the_limit_lowercase",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @showhovertextall=n",
    "send @getstatus:;æøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøåæøå=2222",
    "case getgroup_active_group",
    "send @getgroup=2222",
    "case getinv_unknown_folder",
    "send @getinv:no_such_folder_pinglymotion=2222",
    "case getinvworn_unknown_folder",
    "send @getinvworn:no_such_folder_pinglymotion=2222",
    "case getstatus_nothing_held",
    "send @getstatus=2222",
    "case clear_then_status",
    "send @showhovertextworld=n",
    "send @clear",
    "send @getstatus=2222",
    "case getoutfit_unknown_layer",
    "send @getoutfit:no_such_layer=2222",
    "case getattach_unknown_point",
    "send @getattach:no_such_point=2222",
    "case getcommand_part_of_a_name",
    "send @getcommand:hovertext=2222",
    "case notify_nothing_happens",
    "send @notify:2222=add",
    "send @getstatus=2222",
    "case status_separator_uppercase",
    "send @showhovertextworld=n",
    "send @getstatus:;ÆØÅ=2222",
    "case status_too_long",
    "send @showhovertextworld=n",
    "send @showhovertexthud=n",
    "send @showhovertextall=n",
    "send @getstatus:;æøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅæøåÆØÅ=2222"
];

integer CHUNK = 300;       // characters in one chat line (a chat line holds at most 1023 bytes, and æøå take two)
integer gIndex;
integer gHeard;
integer gAsked;
integer gNotify;
integer gInCase;

say(string text)
{
    llOwnerSay("RLVREF|" + text);
}

// a long text over several chat lines: the first as "<head><text>", the others as "+<text>"
sayLong(string head, string text)
{
    integer n = llStringLength(text);
    if (n <= CHUNK)
    {
        say(head + text);
        return;
    }
    say(head + llGetSubString(text, 0, CHUNK - 1));
    integer i = CHUNK;
    while (i < n)
    {
        say("+" + llGetSubString(text, i, i + CHUNK - 1));
        i += CHUNK;
    }
}

// a command that ends in "=<whole number>" is a question that is answered on that channel
integer isQuestion(string cmd)
{
    integer i = llStringLength(cmd) - 1;
    while (i >= 0 && llGetSubString(cmd, i, i) != "=") i--;
    if (i < 0) return FALSE;
    string tail = llGetSubString(cmd, i + 1, -1);
    if (tail == "") return FALSE;
    return (string)((integer)tail) == tail;
}

// does the next steps until a command is sent (then waits for the answers); TRUE when all is done
integer next()
{
    integer count = llGetListLength(LINES);
    while (gIndex < count)
    {
        string line = llList2String(LINES, gIndex);
        gIndex++;
        if (llGetSubString(line, 0, 4) == "case ")
        {
            if (gInCase) llOwnerSay("@clear");
            gInCase = TRUE;
            gNotify = FALSE;
            sayLong("", line);
        }
        else if (llGetSubString(line, 0, 4) == "send ")
        {
            string cmd = llGetSubString(line, 5, -1);
            sayLong("", line);
            gHeard = 0;
            gAsked = isQuestion(cmd) || gNotify;
            if (llSubStringIndex(cmd, "@notify:") == 0) gNotify = TRUE;
            llOwnerSay(cmd);
            llSetTimerEvent(2.0);
            return FALSE;
        }
        else
        {
            sayLong("", line);
        }
    }
    llOwnerSay("@clear");
    say("# done");
    llSetTimerEvent(0.0);
    return TRUE;
}

default
{
    state_entry()
    {
        llOwnerSay("@clear");
        llOwnerSay("Touch me to ask the RLV questions (about two minutes). Questions only; see the notes at the top of the script.");
    }

    on_rez(integer param)
    {
        llResetScript();
    }

    touch_start(integer n)
    {
        if (llDetectedKey(0) == llGetOwner()) state asking;
    }
}

state asking
{
    state_entry()
    {
        llOwnerSay("@clear");
        say("# start, script made from questions.txt, " + (string)llGetListLength(LINES) + " lines");
        llListen(2222, "", llGetOwner(), "");
        llListen(2223, "", llGetOwner(), "");
        llListen(2224, "", llGetOwner(), "");
        gIndex = 0;
        gInCase = FALSE;
        if (next()) state default;
    }

    listen(integer channel, string name, key id, string message)
    {
        gHeard++;
        sayLong("answer " + (string)channel + " ", message);
        say("# the answer has " + (string)llStringLength(message) + " characters");
    }

    timer()
    {
        llSetTimerEvent(0.0);
        if (gAsked && gHeard == 0) say("silent");
        if (next()) state default;
    }

    state_exit()
    {
        llOwnerSay("@clear");
    }

    on_rez(integer param)
    {
        llResetScript();
    }
}
